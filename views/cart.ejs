<%- include('partials/header') %>
<main><section class="cart-section"><div class="container"><h2>Your Shopping Cart</h2><div class="cart-container"><div class="cart-items"><% if (!items.length) { %><div class="empty-cart"><p>Your cart is empty</p><a href="/" class="btn-primary">Continue Shopping</a></div><% } else { items.forEach((item) => { %><div class="cart-item" data-book-id="<%= item.bookId %>"><img src="<%= item.cover_image %>" alt="<%= item.title %>"><div class="item-details"><h4><a href="/book/<%= item.bookId %>"><%= item.title %></a></h4><p><%= item.author %></p><p class="price">BDT <%= Number(item.price).toFixed(2) %></p></div><div class="item-quantity"><button class="quantity-btn minus" type="button">-</button><span class="quantity"><%= item.quantity %></span><button class="quantity-btn plus" type="button">+</button></div><div class="item-total"><p>BDT <%= Number(item.subtotal).toFixed(2) %></p></div><button class="remove-btn" type="button">Remove</button></div><% }); } %></div><div class="cart-summary"><h3>Order Summary</h3><div class="summary-details"><p>Subtotal <span>BDT <%= subtotal.toFixed(2) %></span></p><p>Delivery Fee <span>BDT <%= deliveryFee.toFixed(2) %></span></p><p>Total <span>BDT <%= (subtotal + deliveryFee).toFixed(2) %></span></p></div><a href="/payment" class="btn-primary">Proceed to Checkout</a></div></div></div></section></main>
<script>document.querySelectorAll('.quantity-btn').forEach((button) => { button.addEventListener('click', async () => { const item = button.closest('.cart-item'); const quantityElement = item.querySelector('.quantity'); let quantity = Number(quantityElement.textContent); if (button.classList.contains('plus')) quantity += 1; else if (quantity > 1) quantity -= 1; const response = await fetch('/api/cart/update', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ book_id: item.dataset.bookId, quantity }) }); const data = await response.json(); if (data.success) location.reload(); else showNotification(data.message, 'error'); }); }); document.querySelectorAll('.remove-btn').forEach((button) => { button.addEventListener('click', async () => { const item = button.closest('.cart-item'); const response = await fetch('/api/cart/remove', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ book_id: item.dataset.bookId }) }); const data = await response.json(); if (data.success) location.reload(); else showNotification(data.message, 'error'); }); });</script>
<%- include('partials/footer') %>