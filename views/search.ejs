<%- include('partials/header') %>
<main><section class="search-page"><div class="container">
  <h2>Search Books</h2>
  <form id="search-form" class="search-bar search-bar-page">
    <input type="text" id="search-input" placeholder="Search by title, author, genre or ISBN...">
    <button type="submit"><i class="fas fa-search"></i></button>
  </form>
  <div id="results" class="books-grid"></div>
</div></section></main>
<script>
  const params = new URLSearchParams(location.search);
  const q = params.get('q') || '';
  const input = document.getElementById('search-input');
  if (input) input.value = q;

  function runSearch(query) {
    const container = document.getElementById('results');
    if (!query) {
      container.innerHTML = '<p class="no-books">Type something to search our catalog.</p>';
      return;
    }
    showLoading('results');
    fetch('/api/books/search?q=' + encodeURIComponent(query))
      .then((r) => r.json())
      .then((books) => {
        if (!books.length) { container.innerHTML = '<p class="no-books">No books found for "' + query + '".</p>'; return; }
        displayBooks(books, 'results');
      })
      .catch(() => { container.innerHTML = '<p class="error-message">Search failed. Please try again.</p>'; });
  }

  document.getElementById('search-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const val = input.value.trim();
    history.replaceState(null, '', '/search?q=' + encodeURIComponent(val));
    runSearch(val);
  });

  if (q) runSearch(q);
  else document.getElementById('results').innerHTML = '<p class="no-books">Type something to search our catalog.</p>';
</script>
<%- include('partials/footer') %>